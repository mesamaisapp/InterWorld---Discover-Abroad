# Sem estas variáveis o app roda com dados de exemplo (src/lib/dados-exemplo.ts).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Coletor (coletor/): no ambiente onde ele roda (GitHub Actions ou local)
# ANTHROPIC_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# COLETOR_MODELO=claude-opus-5-5
# COLETOR_CONTATO=contato@seudominio.com

# Cotações (/cotacao): no servidor da Vercel. Sem a service_role, roda em modo demonstração (memória)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_SENHA=
# RESEND_API_KEY=
# EMAIL_REMETENTE=InterWorld <cotacoes@seudominio.com>
# SITE_URL=https://seudominio.com
# REVISAO_MANUAL=true

# Kit do intercambista (/kit): links de afiliado. Sem a variável, o botão leva ao site normal do parceiro
